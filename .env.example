# Copy to .env (chmod 600). Every var below is read by config.py and/or the
# compose files. In Docker, DATABASE_URL / REDIS_URL / IM_CHANNEL are hardcoded
# by compose — the two below matter only for host-run (tests / non-Docker dev).
DATABASE_URL=postgresql://marketwind:marketwind@postgres:5432/marketwind
REDIS_URL=redis://redis:6379/0

# Reports — REQUIRED. Without these every report fails at the model/search call.
# DeepSeek is OpenAI-compatible, so key + base use the OPENAI_* names.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
BOCHA_API_KEY=

# WeChat push — creds come from `hermes gateway setup` (QR), stored in the mount.
HERMES_HOST_DIR=/root/.hermes
# HERMES_BIN=hermes         # override only if hermes is not on PATH
# WEIXIN_TARGET=weixin

# Prod behavior
TZ=Asia/Shanghai            # cron is wall-clock; MUST be set on the cloud box
REPORT_DEV_LABEL=true       # set false only after eyeballing a verified report

# Nightly Postgres backup -> OSS. Auth = ECS instance RAM role (no static keys).
OSS_BUCKET=mw-deadman
OSSUTIL_AUTH_ARGS=-e oss-cn-beijing-internal.aliyuncs.com --mode EcsRamRole --ecs-role-name <role>
# ^ CONFIRM exact ossutil 2.x RAM-role flags before first run.
# BACKUP_INTERVAL_SECONDS=86400

# Alerts — Bark. A failed backup and the dead-man watcher page you here.
BARK_BASE_URL=https://api.day.app
BARK_KEY=

# Dead-man watcher ping URLs — fill in after `s deploy` of deploy/deadman-fc/.
HEALTHCHECK_URL_PREMARKET=
HEALTHCHECK_URL_MAIN=

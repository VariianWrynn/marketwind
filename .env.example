# Copy to .env. Service names match docker-compose.yml.
# From inside the app container:
DATABASE_URL=postgresql://marketwind:marketwind@postgres:5432/marketwind
REDIS_URL=redis://redis:6379/0

# From the host (running tests against published ports):
# DATABASE_URL=postgresql://marketwind:marketwind@localhost:5432/marketwind
# REDIS_URL=redis://localhost:6379/0

# IM push — P1c. WeChat goes through the installed `hermes` CLI (ADR-0001):
# run `hermes gateway setup` -> Weixin -> scan QR; credentials are stored in
# ~/.hermes/.env (NOT here). This process only needs the channel selection below.
# IM_CHANNEL=hermes_weixin            # stub (default) | hermes_weixin | wecom_webhook
# HERMES_BIN=hermes                   # path/name of the hermes executable
# WEIXIN_TARGET=weixin                # `hermes send --to` target (home channel)
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<key>   # fallback

# Scheduler daemon — vars used by the `scheduler` compose service:
# HERMES_HOST_DIR=C:\Users\<you>\.hermes   # bind-mounted into container at /root/.hermes:ro
#                                           # omit to fall back to ./hermes-creds (non-functional placeholder)
# REPORT_DEV_LABEL=true                    # G0.4: prepend DEV/UNVERIFIED prefix; set false only after Stage-2 owner approval

# Dead-man's switch — per-job Healthchecks ping URLs (see docs/runbooks/deadman-switch.md).
# Empty/unset = disabled (no external check-in). Set only after the second host is provisioned.
# HEALTHCHECK_URL_PREMARKET=https://<second-host>/ping/<premarket-uuid>
# HEALTHCHECK_URL_MAIN=https://<second-host>/ping/<main-uuid>

# --- Aliyun report-node deployment (deploy/report-node/, prod compose override) ---
# TZ=Asia/Shanghai   # host + scheduler + backup timezone; cron is wall-clock, MUST be set on the cloud box.
#
# Nightly Postgres backup sidecar -> OSS. Auth is the ECS INSTANCE RAM ROLE (no static keys):
# attach a role granting oss:PutObject on mw-deadman/backups/* to the ECS instance.
# OSS_BUCKET=mw-deadman
# OSSUTIL_AUTH_ARGS=-e oss-cn-beijing-internal.aliyuncs.com --mode EcsRamRole --ecs-role-name <instance-ram-role>
#   # ^ CONFIRM the exact ossutil 2.x RAM-role flags against current ossutil docs before first run.
# BACKUP_INTERVAL_SECONDS=86400
#
# FC dead-man watcher: point the HEALTHCHECK_URL_* vars above at the FC `ping` endpoint from `s deploy`,
# e.g. HEALTHCHECK_URL_PREMARKET=https://<fc-ping-url>?job=premarket  (and ...?job=main for MAIN).

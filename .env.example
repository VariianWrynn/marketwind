# Copy to .env. Service names match docker-compose.yml.
# From inside the app container:
DATABASE_URL=postgresql://marketwind:marketwind@postgres:5432/marketwind
REDIS_URL=redis://redis:6379/0

# From the host (running tests against published ports):
# DATABASE_URL=postgresql://marketwind:marketwind@localhost:5432/marketwind
# REDIS_URL=redis://localhost:6379/0

# IM push — P1c. WeChat goes through the installed `hermes` CLI (ADR-0001):
# run `hermes gateway setup` -> Weixin -> scan QR; credentials are stored in
# ~/.hermes/.env (NOT here). This process only needs the channel selection below.
# IM_CHANNEL=hermes_weixin            # stub (default) | hermes_weixin | wecom_webhook
# HERMES_BIN=hermes                   # path/name of the hermes executable
# WEIXIN_TARGET=weixin                # `hermes send --to` target (home channel)
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<key>   # fallback

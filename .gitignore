# Secrets — live keys live in .env; only .env.example is tracked
.env
.env.*
!.env.example

# Owner deployment parameter notes (may hold real endpoints/keys) — never commit
*部署参数*.txt
阿里云部署参数.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Build / dist
build/
dist/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local fixtures cache / scratch (keep committed fixtures under tests/)
*.local

# One-off smoke / scratch scripts (not part of the test suite). Scripts that the
# owner actually reruns are re-included below — git cannot re-include under an
# excluded *directory*, hence the glob rather than `/scripts/`.
/scripts/*
!/scripts/smoke_p1a.py
!/scripts/push_wechat_live.py

# Agent worktrees — full repo copies; never part of a commit or a lint sweep
.claude/worktrees/
